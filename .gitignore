# Secrets / credentials — must never be committed
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Caches generated at runtime
src/.cache_v3/
.cache/

# Offline knowledge base — ~1 GB, downloaded from the Dropbox link in README.md
knowledge_base/*.csv
knowledge_base/*.json
!knowledge_base/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
